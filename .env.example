# JWT Secret Key for Authentication Token Signing
SECRET_KEY=sif-enterprise-secret-key-change-in-production

# Model Path (Local path or Hugging Face Hub Repository ID e.g., darsh90844/sif)
MODEL_PATH=darsh90844/sif

# Allowed CORS Origins (comma separated list or * for all)
ALLOWED_ORIGINS=*

# Server Port (automatically set by Render / Railway)
PORT=8000
